# Server-side only. Set these in Vercel -> Project -> Settings -> Environment Variables.
# Never prefix with VITE_ (that would expose the value in the browser bundle).

# Resend API key used by api/contact.ts to email contact-form enquiries.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"

# Optional overrides (defaults shown). CONTACT_FROM's domain must be verified in Resend.
# CONTACT_TO="client@lycanforge.com.ng"
# CONTACT_FROM="LycanForge Website <noreply@lycanforge.com.ng>"
